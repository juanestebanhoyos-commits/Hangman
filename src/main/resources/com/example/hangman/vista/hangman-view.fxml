<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.hangman.controlador.HangmanController"
            stylesheets="@hangman.css" styleClass="raiz">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <padding>
                <Insets bottom="12.0"/>
            </padding>
            <Label text="Jugador:"/>
            <TextField fx:id="nombreField" promptText="Escriba su nombre" HBox.hgrow="ALWAYS"/>
            <Button fx:id="nuevaPartidaButton" text="Nueva partida" onAction="#iniciarPartida"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="18.0">
            <HBox fx:id="cajasPalabra" alignment="CENTER" spacing="6.0" minHeight="60.0"/>
            <Label fx:id="intentosLabel" text="Intentos restantes: 6" styleClass="intentos"/>
            <Label fx:id="mensajeLabel" text="Escriba su nombre y pulse Nueva partida."
                   wrapText="true" textAlignment="CENTER" styleClass="mensaje"/>
        </VBox>
    </center>

    <bottom>
        <VBox spacing="8.0">
            <padding>
                <Insets top="12.0"/>
            </padding>
            <Button fx:id="verHistorialButton" text="Ver historial"/>
            <ListView fx:id="historialLista" prefHeight="140.0"/>
        </VBox>
    </bottom>
</BorderPane>
